{
	"name": "betteroff-cli",
	"version": "0.1.2",
	"description": "Read your BetterOff household from the terminal.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.4.3",
	"bin": {
		"betteroff": "./src/main.ts"
	},
	"scripts": {
		"build": "bun build src/main.ts --compile --minify --outfile dist/betteroff",
		"lint": "biome check . --diagnostic-level=error",
		"test": "bun test src/test",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@raintree-technology/trellis": "0.3.2",
		"@types/bun": "1.4.3",
		"typescript": "7.0.2"
	},
	"engines": {
		"bun": ">=1.4.3"
	}
}
